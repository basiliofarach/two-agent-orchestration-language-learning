# The harness reads SIM_* (pydantic-settings). Defaults are in SimulationSettings.
# Paths are relative to the directory you run `python -m tutor_sim` from.
SIM_API_BASE_URL=http://127.0.0.1:8000
SIM_DATASET_DIR=datasets/sim/unreleased
SIM_EVIDENCE_DIR=evidence
SIM_OLLAMA_BASE_URL=http://127.0.0.1:11434
SIM_RUNTIME_PIN_PATH=config/runtime.toml
SIM_SEED=0
SIM_CACHE_DIR=.cache/sim
SIM_OFFLINE=false
SIM_SOURCES_PATH=datasets/sim/unreleased/public/sources.json
