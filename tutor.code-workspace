{
  "folders": [
    {
      "name": "root",
      "path": "."
    },
    {
      "name": "tutor-core",
      "path": "tutor-core"
    },
    {
      "name": "tutor-api",
      "path": "tutor-api"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:root}/.venv/bin/python",
    "python.analysis.extraPaths": [
      "${workspaceFolder:root}/tutor-core/src",
      "${workspaceFolder:root}/tutor-api/src"
    ],
    "basedpyright.analysis.extraPaths": [
      "${workspaceFolder:root}/tutor-core/src",
      "${workspaceFolder:root}/tutor-api/src"
    ],
    "pylint.args": [
      "--source-roots",
      "${workspaceFolder:root}/tutor-core/src",
      "--source-roots",
      "${workspaceFolder:root}/tutor-api/src",
      "--init-hook",
      "import sys; sys.path[:0] = [r'${workspaceFolder:root}/tutor-core/src', r'${workspaceFolder:root}/tutor-api/src']",
      "--known-first-party",
      "tutor_core,tutor_api"
    ],
    "python.terminal.useEnvFile": true,
    "python.envFile": "${workspaceFolder:tutor-api}/.env",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tutor-core/tests",
      "tutor-api/tests"
    ],
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "explicit",
        "source.organizeImports.ruff": "explicit"
      }
    },
    "[javascript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports.biome": "explicit"
      }
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true
    },
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports.biome": "explicit"
      }
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports.biome": "explicit"
      }
    },
    "[css]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true
    }
  },
  "extensions": {
    "recommendations": [
      "charliermarsh.ruff",
      "biomejs.biome"
    ]
  }
}
