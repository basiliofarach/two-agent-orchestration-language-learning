# Copy to tutor-api/.env. Compose reads this file automatically.
#
# ApplicationSettings resolves `.env` against the working directory, so run
# backend commands from tutor-api/ as the Makefile states. From elsewhere the
# file is simply not found and the values below fall back to their defaults —
# Alembic then fails with `POSTGRES_USER is not set` rather than connecting
# somewhere unintended.
POSTGRES_USER=tutor_owner
POSTGRES_PASSWORD=tutor_owner
POSTGRES_DB=tutor
POSTGRES_APP_USER=tutor_app
POSTGRES_APP_PASSWORD=tutor_app
# learner-postgres already owns 5432 on this machine.
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1

# Alembic builds its URL from the values above. Set DATABASE_URL to override
# them outright — a managed instance, or CI. The driver is normalised to
# psycopg either way, because Alembic runs synchronously.
# DATABASE_URL=postgresql+asyncpg://tutor_owner:tutor_owner@127.0.0.1:5433/tutor

# Envelope key for encryption at rest (DEC-0012): base64 of 32 random bytes,
# and its id. Generate once and keep both. Data sealed under one key does not
# open under another, so `make seed` and `make serve` must see the same pair.
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
#   python3 -c "import uuid; print(uuid.uuid4())"
TUTOR_KEK=
TUTOR_KEK_ID=

# History fields this deployment may read (REQ-HISTORY). Blank is the empty set.
HISTORY_FIELDS=proficiency_level,events
# Must equal the conflict-threshold rule on the published policy card. `make
# seed` publishes this value; the conflict gate stops a turn if they differ.
CONFLICT_CONFIDENCE_THRESHOLD=0.3

# The weights pin (DEC-0007), relative to tutor-api/.
MODEL_PIN_PATH=../config/runtime.toml
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Where `uv run tutor-api` listens. Defaults shown.
# API_HOST=127.0.0.1
# API_PORT=8000
